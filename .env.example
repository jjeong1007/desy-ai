# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never expose to the browser. Used for account deletion and MCP token lookup.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private demo account for feedback sessions (npm run demo:reset creates it or empties it).
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=choose-a-strong-password
